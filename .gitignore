# Dependencias de Node.js (raíz y cualquier subdirectorio como backend/frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

*/node_modules

# Compilados y builds
dist/
build/
out/
.next/
*.tsbuildinfo

# Variables de entorno y secretos
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log

# Archivos de cobertura de pruebas y caches de pruebas
coverage/
*.lcov
.nyc_output/

# Entorno local (MariaDB portable, datos, logs)
.local/

# Caches y herramientas de desarrollo
.cache/
.eslintcache
.stylelintcache
.vite/
.parcel-cache/

# Archivos temporales y de sistema operativo
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Configuraciones de IDE / Editores de código
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace

# Python / Scripts temporales (ej. en tools/)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
